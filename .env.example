# Reference only. Run `bash scripts/init-env.sh` (or scripts/init-env.ps1) to generate a real .env with random secrets.
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
PAYMENT_PROVIDER_API_KEY=CHANGE_ME_AT_LEAST_16_CHARS
RABBITMQ_PASSWORD=CHANGE_ME

# Fictional demo users (admin@ / auditor@ / demo@walletflow.test). Set SEED_ENABLED=false for no demo data.
SEED_ENABLED=true
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_AUDITOR_PASSWORD=CHANGE_ME
SEED_DEMO_PASSWORD=CHANGE_ME

# Optional features, enabled together with the matching compose profile
IDEMPOTENCY_PROVIDER=Redis        # or Postgres
MESSAGING_PROVIDER=Log            # RabbitMq with --profile messaging
OTEL_ENDPOINT=                    # http://jaeger:4318 with --profile observability
OTEL_EXPORT_METRICS=false         # true only if the endpoint is a full OpenTelemetry Collector
SEQ_URL=                          # http://seq:5341 with --profile observability
